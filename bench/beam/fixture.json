  "conversations": [
    {
      "id": "conv-001",
      "messages": [
        {
          "role": "user",
          "content": "I'm building an agent memory system called Ohara. It should be a single binary."
        },
        {
          "role": "assistant",
          "content": "A single binary memory system is a great constraint. What storage engine are you considering?"
        },
        {
          "role": "user",
          "content": "SQLite with FTS5 for search, pure-Go only. No CGO."
        },
        {
          "role": "assistant",
          "content": "modernc.org/sqlite gives you pure-Go SQLite. For vectors, the vec0 extension is available now."
        },
        {
          "role": "user",
          "content": "The vec0 extension is in modernc v1.47.0+. But we need to stay on v1.45.0 for now."
        },
        {
          "role": "assistant",
          "content": "Understood. For small N (<1000 items), brute-force cosine works fine in Go."
        }
      ]
    },
    {
      "id": "conv-002",
      "messages": [
        {
          "role": "user",
          "content": "How should we handle memory deduplication?"
        },
        {
          "role": "assistant",
          "content": "Use normalized_hash on the content body. Store it in the database and check on insert."
        },
        {
          "role": "user",
          "content": "What about topic_key upserts? Should we keep those?"
        },
        {
          "role": "assistant",
          "content": "Yes, topic_key upserts are critical. They allow evolving topics to update a single observation over time."
        },
        {
          "role": "user",
          "content": "And for soft-deletes — we use deleted_at, right?"
        },
        {
          "role": "assistant",
          "content": "Correct. Never hard-delete. Set deleted_at and filter in queries. This preserves the audit trail."
        }
      ]
    },
    {
      "id": "conv-003",
      "messages": [
        {
          "role": "user",
          "content": "We need to set up CI for Ohara. What should we include?"
        },
        {
          "role": "assistant",
          "content": "Start with go test and go vet. Add binary size checks and dependency audits for every PR."
        },
        {
          "role": "user",
          "content": "Should we use GitHub Actions or run a custom pipeline?"
        },
        {
          "role": "assistant",
          "content": "GitHub Actions is simpler for a single-binary Go project. The ci.yml already has build and test jobs."
        },
        {
          "role": "user",
          "content": "What about cross-platform builds? We need linux/amd64 and darwin/arm64."
        },
        {
          "role": "assistant",
          "content": "Use GOOS and GOARCH in the build matrix. Keep the binary stripped with ldflags -s -w."
        },
        {
          "role": "user",
          "content": "And automated benchmarks? We want to track performance regressions."
        },
        {
          "role": "assistant",
          "content": "Add a bench job with benchstat. Run it on PRs labeled bench to avoid CI bloat."
        }
      ]
    }
  ],
